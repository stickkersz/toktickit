# Where the Vite dev server forwards /api requests. Optional: the default is
# http://127.0.0.1:3000, the server's default PORT. Set it if your server runs
# on another port. Use 127.0.0.1, not localhost.
# VITE_API_PROXY_TARGET="http://127.0.0.1:3000"

# Leave VITE_API_URL UNSET for normal development: requests then go to a relative
# /api through the proxy above and the session cookie stays first-party. Set it
# only to call an API on another origin directly, which then needs that origin
# listed in the server's CORS_ORIGINS and only carries the cookie when both
# origins are the same site.
# VITE_API_URL="http://localhost:3000"

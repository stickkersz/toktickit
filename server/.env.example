# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000
# Browser origins allowed to send the session cookie, comma separated. Optional:
# the default covers the Vite dev server and the Playwright client on localhost
# and 127.0.0.1. A "*" entry is ignored: credentialed CORS needs exact origins.
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
